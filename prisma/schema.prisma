// PostgreSQL schema for OPERATIVO (local server of each parking lot, works offline).
// The connection URL lives in prisma.config.ts (Prisma 7 no longer reads it from here).
//
// Conventions (same as ADMINISTRATIVO)
// - Model and field names follow the domain entities (Ticket, Modulo, nombre, ...);
//   tables and columns are snake_case via @@map/@map.
// - Instants are timestamptz; money is numeric(12,2). Datasources convert to the
//   epoch-millisecond numbers the domain and API use today. The old -1 sentinels are NULL.
//
// Ownership
// - Projections (owner = ADMINISTRATIVO): Usuario, PermissionProfile, Proyecto, Modulo,
//   Pension, PensionPass. Their ids come from the cloud (no default) and they are only
//   written by the config/access sync, which upserts and never deletes. Natural keys
//   (correo, identificador, idPass) are indexed but not unique: the cloud enforces them,
//   and a local unique index could reject a sync that swaps two values.
// - Local data (owner = OPERATIVO): device state of the modules, tickets, payments,
//   cash register, pension moves, logs. Primary keys are UUID v7 generated by Prisma.
// - Users referenced by local data (usuarioId, ...ByUserId) are not foreign keys: they can
//   be cloud users that never reach this installation (mobile clients, pension holders).

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserApp {
  ADMIN_WEB
  OPERATIVE_WEB
  OPERATIVE_MOBILE

  @@map("user_app")
}

enum UserModule {
  cashPayments
  users
  permissionProfiles
  installations
  projects
  modules
  pensions
  pensionPasses
  tickets
  pensionMoves
  payments

  @@map("user_module")
}

enum ModuloTipo {
  ENTRADA
  SALIDA
  POS

  @@map("modulo_tipo")
}

enum SubmoduloTipo {
  QR_SCANNER
  PRINTER
  BARRIER
  CAMERA
  CASH_DRAWER
  CASH_ACCEPTOR
  DISPLAY
  KEYPAD
  OTHER

  @@map("submodulo_tipo")
}

enum RemoteSupportProvider {
  MESHCENTRAL
  RUSTDESK
  VIGGO_REMOTE
  CUSTOM

  @@map("remote_support_provider")
}

enum DeviceConnectionStatus {
  CONNECTED
  DISCONNECTED
  PENDING
  REJECTED
  MISMATCH

  @@map("device_connection_status")
}

enum DeviceApprovalStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("device_approval_status")
}

enum TicketStatus {
  ACTIVE
  COMPLETED
  FRAUD

  @@map("ticket_status")
}

enum PensionMoveTipo {
  ENTRADA
  SALIDA
  ENTRADA_PENSION @map("ENTRADA-PENSION")
  SALIDA_PENSION  @map("SALIDA-PENSION")

  @@map("pension_move_tipo")
}

enum PaymentType {
  ticket
  pension
  renewal

  @@map("payment_type")
}

enum PaymentStatus {
  succeeded
  pending
  failed
  refunded

  @@map("payment_status")
}

enum CashPaymentSessionStatus {
  created
  pending_cash
  partially_paid
  paid
  cancelled
  expired
  failed

  @@map("cash_payment_session_status")
}

enum CashPaymentSessionEventType {
  session_created
  qr_resolved
  cash_inserted
  cash_rejected
  change_calculated
  session_completed
  session_cancelled
  session_expired
  session_failed

  @@map("cash_payment_session_event_type")
}

enum CashRegisterShiftStatus {
  open
  closed
  reconciled
  cancelled

  @@map("cash_register_shift_status")
}

enum CashRegisterMovementType {
  opening_fund
  ticket_payment_income
  manual_income
  manual_expense
  cash_withdrawal
  refund
  adjustment

  @@map("cash_register_movement_type")
}

enum CashMovementDirection {
  in
  out

  @@map("cash_movement_direction")
}

enum CashRegisterCutStatus {
  balanced
  short
  over

  @@map("cash_register_cut_status")
}

enum OperationalLogKind {
  event
  incident

  @@map("operational_log_kind")
}

enum OperationalLogScope {
  access_flow
  device
  payment
  system

  @@map("operational_log_scope")
}

enum OperationalLogSeverity {
  info
  warning
  critical

  @@map("operational_log_severity")
}

enum OperationalLogSource {
  backend
  device
  app
  sync
  system

  @@map("operational_log_source")
}

enum OperationalLogFlushType {
  monthly
  partial

  @@map("operational_log_flush_type")
}

enum MonthlyFlushTrigger {
  manual
  automatic
  partial

  @@map("monthly_flush_trigger")
}

enum MonthlyFlushJobStatus {
  running
  completed
  failed

  @@map("monthly_flush_job_status")
}

enum LocalInstallationStatus {
  pending
  requested
  approved
  rejected
  linked

  @@map("local_installation_status")
}

enum LocalInstallationSource {
  env
  manual
  cloudApproval

  @@map("local_installation_source")
}

enum ConfigSyncStatus {
  success
  success_with_warnings
  failed

  @@map("config_sync_status")
}

enum ConfigSyncTrigger {
  manual
  automatic
  system

  @@map("config_sync_trigger")
}

// ─────────────────── Projections: identity & access ───────────────────

/// Users synced from ADMINISTRATIVO (access snapshot); used for offline login.
model Usuario {
  id                      String    @id @db.Uuid
  nombre                  String
  apellido                String
  /// Stored lowercase.
  correo                  String
  emailValidated          Boolean   @default(false) @map("email_validated")
  telefono                String
  coordinates             Float[]   @default([])
  /// bcrypt hash, so cashiers can log in while the cloud is unreachable.
  password                String
  /// Role code (SUPER_ROLE, ADMIN_ROLE, ...); the role catalog lives in the cloud.
  rol                     String    @default("CLIENT_ROLE")
  /// Projects the user may operate (ids of cloud projects, not only this one).
  parkings                String[]  @default([]) @db.Uuid
  allowedApps             UserApp[] @default([]) @map("allowed_apps")
  nacimiento              DateTime? @db.Timestamptz(3)
  img                     String    @default("")
  estado                  Boolean   @default(true)
  google                  Boolean   @default(false)
  // Local only.
  barrierBlasterHighScore Int       @default(0) @map("barrier_blaster_high_score")
  syncSource              String    @default("administrativo") @map("sync_source")
  lastSyncedAt            DateTime? @map("last_synced_at") @db.Timestamptz(3)
  lastCloudCheckAt        DateTime? @map("last_cloud_check_at") @db.Timestamptz(3)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  appPermissions UsuarioAppPermission[]

  @@index([correo])
  @@index([telefono])
  @@index([parkings], type: Gin)
  @@index([rol])
  @@map("usuarios")
}

/// One permission profile per user and app. The profile may not be synced here
/// (the integrity check reports it), so it is not a foreign key.
model UsuarioAppPermission {
  usuarioId           String  @map("usuario_id") @db.Uuid
  app                 UserApp
  permissionProfileId String  @map("permission_profile_id") @db.Uuid

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([usuarioId, app])
  @@index([permissionProfileId])
  @@map("usuario_app_permissions")
}

model PermissionProfile {
  id          String       @id @db.Uuid
  app         UserApp
  nombre      String
  descripcion String       @default("")
  modules     UserModule[] @default([])
  estado      Boolean      @default(true)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([app])
  @@map("permission_profiles")
}

// ─────────────────── Projections: parking & modules ───────────────────

model Proyecto {
  id              String   @id @db.Uuid
  nombre          String
  /// [lon, lat] or a polygon [[lon, lat], ...].
  coordinates     Json
  ciudad          String
  direccion       String   @default("")
  identificador   String
  codigoProyecto  String?  @map("codigo_proyecto") @db.VarChar(4)
  serverIp        String   @default("") @map("server_ip")
  serverMac       String   @default("") @map("server_mac")
  localApiBaseUrl String   @default("") @map("local_api_base_url")
  img             String   @default("")
  descripcion     String   @default("")
  estado          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  remoteSupport ProyectoRemoteSupport?
  modulos       Modulo[]
  pensiones     Pension[]
  tickets       Ticket[]
  parkingRates  ParkingRate[]
  pensionMoves  PensionMove[]

  @@index([identificador])
  @@map("proyectos")
}

model ProyectoRemoteSupport {
  proyectoId String                @id @map("proyecto_id") @db.Uuid
  provider   RemoteSupportProvider @default(MESHCENTRAL)
  enabled    Boolean               @default(false)
  baseUrl    String                @default("") @map("base_url")
  groupId    String                @default("") @map("group_id")
  updatedAt  DateTime?             @map("updated_at") @db.Timestamptz(3)

  proyecto Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@map("proyecto_remote_support")
}

/// Module configuration comes from the cloud; the device state tables below are local.
model Modulo {
  id            String     @id @db.Uuid
  proyectoId    String     @map("proyecto_id") @db.Uuid
  nombre        String
  tipo          ModuloTipo
  estado        Boolean    @default(true)
  identificador String
  ip            String     @default("")
  mac           String     @default("")
  ubicacion     String     @default("")
  longitude     Float?
  latitude      Float?
  descripcion   String     @default("")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  proyecto            Proyecto                     @relation(fields: [proyectoId], references: [id], onDelete: Restrict)
  submodulos          Submodulo[]
  remoteSupport       ModuloRemoteSupport?
  deviceBinding       ModuloDeviceBinding?
  bindingRequests     ModuloDeviceBindingRequest[]
  connectionAudit     ModuloConnectionAudit?
  deviceRuntime       ModuloDeviceRuntime?
  ticketsEntrada      Ticket[]                     @relation("TicketEntrada")
  ticketsSalida       Ticket[]                     @relation("TicketSalida")
  cashPaymentSessions CashPaymentSession[]
  cashRegisterShifts  CashRegisterShift[]
  pensionMoves        PensionMove[]

  @@index([proyectoId, tipo, estado])
  @@index([identificador])
  @@map("modulos")
}

model Submodulo {
  id            String        @id @default(uuid(7)) @db.Uuid
  moduloId      String        @map("modulo_id") @db.Uuid
  /// Key the API uses for the sub-module (from the cloud).
  submoduloId   String        @map("submodulo_id")
  /// Keeps the order the admin defined.
  position      Int           @default(0)
  nombre        String
  tipo          SubmoduloTipo @default(OTHER)
  identificador String        @default("")
  ip            String        @default("")
  mac           String        @default("")
  ubicacion     String        @default("")
  longitude     Float?
  latitude      Float?
  descripcion   String        @default("")
  estado        Boolean       @default(true)

  modulo Modulo @relation(fields: [moduloId], references: [id], onDelete: Cascade)

  @@unique([moduloId, submoduloId])
  @@index([moduloId, position])
  @@map("submodulos")
}

model ModuloRemoteSupport {
  moduloId    String                @id @map("modulo_id") @db.Uuid
  provider    RemoteSupportProvider @default(MESHCENTRAL)
  enabled     Boolean               @default(false)
  deviceName  String                @default("") @map("device_name")
  deviceId    String                @default("") @map("device_id")
  groupId     String                @default("") @map("group_id")
  baseUrl     String                @default("") @map("base_url")
  supportUrl  String                @default("") @map("support_url")
  desktopUrl  String                @default("") @map("desktop_url")
  terminalUrl String                @default("") @map("terminal_url")
  linkedAt    DateTime?             @map("linked_at") @db.Timestamptz(3)
  updatedAt   DateTime?             @map("updated_at") @db.Timestamptz(3)

  modulo Modulo @relation(fields: [moduloId], references: [id], onDelete: Cascade)

  @@map("modulo_remote_support")
}

// ─────────────────── Local: device state of the modules ───────────────────

/// Physical device authorized to act as the module (was Modulo.deviceBinding).
model ModuloDeviceBinding {
  moduloId             String    @id @map("modulo_id") @db.Uuid
  /// sha256(cpu_serial|machine_id|primary_mac) computed by the device.
  fingerprint          String
  cpuSerial            String    @default("") @map("cpu_serial")
  machineId            String    @default("") @map("machine_id")
  primaryMac           String    @default("") @map("primary_mac")
  deviceSecretHash     String    @default("") @map("device_secret_hash")
  deviceSecretIssuedAt DateTime? @map("device_secret_issued_at") @db.Timestamptz(3)
  boundAt              DateTime  @map("bound_at") @db.Timestamptz(3)
  lastSeenAt           DateTime  @map("last_seen_at") @db.Timestamptz(3)

  modulo Modulo @relation(fields: [moduloId], references: [id], onDelete: Cascade)

  @@index([fingerprint])
  @@map("modulo_device_bindings")
}

/// Devices asking to be bound to a module (was Modulo.deviceBindingRequests).
model ModuloDeviceBindingRequest {
  id            String               @id @default(uuid(7)) @db.Uuid
  moduloId      String               @map("modulo_id") @db.Uuid
  fingerprint   String
  cpuSerial     String               @default("") @map("cpu_serial")
  machineId     String               @default("") @map("machine_id")
  primaryMac    String               @default("") @map("primary_mac")
  ipAddress     String               @default("") @map("ip_address")
  locationLabel String               @default("") @map("location_label")
  status        DeviceApprovalStatus
  requestedAt   DateTime             @map("requested_at") @db.Timestamptz(3)
  resolvedAt    DateTime?            @map("resolved_at") @db.Timestamptz(3)
  notes         String               @default("")

  modulo Modulo @relation(fields: [moduloId], references: [id], onDelete: Cascade)

  /// A device has at most one pending request per module.
  @@unique([moduloId, fingerprint], map: "modulo_device_binding_requests_pending_key", where: raw("status = 'PENDING'::device_approval_status"))
  @@index([status, requestedAt])
  @@index([moduloId, requestedAt])
  @@map("modulo_device_binding_requests")
}

/// Last connection attempt of a device to the module (was Modulo.deviceConnectionAudit).
model ModuloConnectionAudit {
  moduloId      String               @id @map("modulo_id") @db.Uuid
  fingerprint   String               @default("")
  cpuSerial     String               @default("") @map("cpu_serial")
  machineId     String               @default("") @map("machine_id")
  primaryMac    String               @default("") @map("primary_mac")
  ipAddress     String               @default("") @map("ip_address")
  locationLabel String               @default("") @map("location_label")
  socketId      String               @default("") @map("socket_id")
  status        DeviceApprovalStatus @default(PENDING)
  reason        String               @default("")
  attemptedAt   DateTime?            @map("attempted_at") @db.Timestamptz(3)

  modulo Modulo @relation(fields: [moduloId], references: [id], onDelete: Cascade)

  @@map("modulo_connection_audits")
}

/// Live socket state of the module's device (was Modulo.deviceRuntime).
model ModuloDeviceRuntime {
  moduloId         String                 @id @map("modulo_id") @db.Uuid
  fingerprint      String                 @default("")
  socketId         String                 @default("") @map("socket_id")
  ipAddress        String                 @default("") @map("ip_address")
  locationLabel    String                 @default("") @map("location_label")
  connectionStatus DeviceConnectionStatus @default(DISCONNECTED) @map("connection_status")
  isConnected      Boolean                @default(false) @map("is_connected")
  isAuthorized     Boolean                @default(false) @map("is_authorized")
  connectedAt      DateTime?              @map("connected_at") @db.Timestamptz(3)
  lastHeartbeatAt  DateTime?              @map("last_heartbeat_at") @db.Timestamptz(3)
  lastDisconnectAt DateTime?              @map("last_disconnect_at") @db.Timestamptz(3)
  message          String                 @default("")

  modulo Modulo @relation(fields: [moduloId], references: [id], onDelete: Cascade)

  @@index([isConnected, lastHeartbeatAt])
  @@map("modulo_device_runtimes")
}

// ─────────────────────── Projections: pensions ───────────────────────

model Pension {
  id          String   @id @db.Uuid
  proyectoId  String   @map("proyecto_id") @db.Uuid
  nombre      String
  precio      Decimal  @db.Decimal(12, 2)
  descripcion String   @default("")
  estado      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  proyecto Proyecto         @relation(fields: [proyectoId], references: [id], onDelete: Restrict)
  horarios PensionHorario[]
  passes   PensionPass[]

  @@index([proyectoId, estado])
  @@map("pensiones")
}

/// Weekly validity window, one row per weekday (was Pension.validez[7]).
model PensionHorario {
  pensionId   String @map("pension_id") @db.Uuid
  /// 0..6, same numbering the API uses.
  weekDay     Int    @map("week_day") @db.SmallInt
  /// Minutes since midnight, 0..1439 (from [HH, MM]).
  fromMinutes Int    @map("from_minutes") @db.SmallInt
  toMinutes   Int    @map("to_minutes") @db.SmallInt

  pension Pension @relation(fields: [pensionId], references: [id], onDelete: Cascade)

  @@id([pensionId, weekDay])
  @@map("pension_horarios")
}

model PensionPass {
  id           String    @id @db.Uuid
  pensionId    String    @map("pension_id") @db.Uuid
  /// Cloud user holding the pass (not synced here unless they operate the parking).
  usuarioId    String?   @map("usuario_id") @db.Uuid
  name         String
  idPass       String    @map("id_pass")
  vigent       Boolean   @default(false)
  antiPassback Boolean   @default(true) @map("anti_passback")
  /// Local only: whether the car is inside (anti-passback). The sync must not overwrite it.
  inParking    Boolean   @default(false) @map("in_parking")
  created      DateTime  @db.Timestamptz(3)
  /// Null = not contracted yet (was -1).
  validFrom    DateTime? @map("valid_from") @db.Timestamptz(3)
  validTo      DateTime? @map("valid_to") @db.Timestamptz(3)
  estado       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  pension Pension       @relation(fields: [pensionId], references: [id], onDelete: Restrict)
  moves   PensionMove[]

  @@index([idPass])
  @@index([pensionId])
  @@index([usuarioId])
  @@map("pension_passes")
}

// ───────────────────────── Local: parking operation ─────────────────────────

/// Parking rate of a project, owned by OPERATIVO (it is not part of the project snapshot the
/// cloud overwrites). Rows are immutable versions: the highest one is the current rate.
model ParkingRate {
  id                String   @id @default(uuid(7)) @db.Uuid
  proyectoId        String   @map("proyecto_id") @db.Uuid
  version           Int
  toleranceMinutes  Int      @map("tolerance_minutes")
  firstBlockMinutes Int      @map("first_block_minutes")
  firstBlockPrice   Decimal  @map("first_block_price") @db.Decimal(12, 2)
  fractionMinutes   Int      @map("fraction_minutes")
  fractionPrice     Decimal  @map("fraction_price") @db.Decimal(12, 2)
  /// Null: no daily cap.
  dailyMax          Decimal? @map("daily_max") @db.Decimal(12, 2)
  /// User who saved this version.
  createdBy         String   @default("") @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  proyecto Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Restrict)

  @@unique([proyectoId, version])
  @@map("parking_rates")
}

model Ticket {
  id                 String       @id @default(uuid(7)) @db.Uuid
  proyectoId         String       @map("proyecto_id") @db.Uuid
  entradaId          String       @map("entrada_id") @db.Uuid
  salidaId           String?      @map("salida_id") @db.Uuid
  usuarioId          String       @map("usuario_id") @db.Uuid
  /// Printed/QR ticket number.
  idBoleto           String       @unique @map("id_boleto")
  horaInicio         DateTime     @map("hora_inicio") @db.Timestamptz(3)
  horaConsulta       DateTime?    @map("hora_consulta") @db.Timestamptz(3)
  horaCobro          DateTime?    @map("hora_cobro") @db.Timestamptz(3)
  horaSalida         DateTime?    @map("hora_salida") @db.Timestamptz(3)
  /// Minutes.
  duracion           Int          @default(0)
  monto              Decimal      @default(0) @db.Decimal(12, 2)
  pagado             Boolean      @default(false)
  status             TicketStatus @default(ACTIVE)
  barrierOpenedAt    DateTime?    @map("barrier_opened_at") @db.Timestamptz(3)
  barrierConfirmedAt DateTime?    @map("barrier_confirmed_at") @db.Timestamptz(3)
  fraudDetectedAt    DateTime?    @map("fraud_detected_at") @db.Timestamptz(3)
  fraudReason        String       @default("") @map("fraud_reason")
  idempotencyKey     String?      @unique @map("idempotency_key")
  exitIdempotencyKey String?      @unique @map("exit_idempotency_key")
  /// Device runtime events already applied to this ticket (dedupe).
  runtimeEventIds    String[]     @default([]) @map("runtime_event_ids")
  /// Version of the parking rate the amount was last quoted with (null: the legacy fixed rate).
  tarifaVersion      Int?         @map("tarifa_version")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  proyecto            Proyecto             @relation(fields: [proyectoId], references: [id], onDelete: Restrict)
  entrada             Modulo               @relation("TicketEntrada", fields: [entradaId], references: [id], onDelete: Restrict)
  salida              Modulo?              @relation("TicketSalida", fields: [salidaId], references: [id], onDelete: Restrict)
  cashPaymentSessions CashPaymentSession[]

  /// A user has at most one ticket without exit (the code's notion of "active": a ticket
  /// flagged as FRAUD at the entry is still inside).
  @@unique([usuarioId], map: "tickets_active_usuario_key", where: raw("hora_salida IS NULL"))
  @@index([usuarioId, horaInicio(sort: Desc)])
  @@index([proyectoId, horaInicio(sort: Desc)])
  @@index([status, horaInicio])
  @@map("tickets")
}

model PensionMove {
  id            String          @id @default(uuid(7)) @db.Uuid
  moduloId      String          @map("modulo_id") @db.Uuid
  proyectoId    String          @map("proyecto_id") @db.Uuid
  pensionPassId String          @map("pension_pass_id") @db.Uuid
  tipo          PensionMoveTipo
  fecha         DateTime        @db.Timestamptz(3)

  modulo      Modulo      @relation(fields: [moduloId], references: [id], onDelete: Restrict)
  proyecto    Proyecto    @relation(fields: [proyectoId], references: [id], onDelete: Restrict)
  pensionPass PensionPass @relation(fields: [pensionPassId], references: [id], onDelete: Restrict)

  @@index([pensionPassId, fecha(sort: Desc)])
  @@index([proyectoId, fecha(sort: Desc)])
  @@map("pension_moves")
}

/// Payments recorded locally: cash at the POS and cloud (app) ticket payments.
model Payment {
  id                 String        @id @default(uuid(7)) @db.Uuid
  usuarioId          String        @map("usuario_id") @db.Uuid
  type               PaymentType
  concept            String
  amount             Decimal       @db.Decimal(12, 2)
  /// ISO 4217, uppercase.
  currency           String        @db.Char(3)
  status             PaymentStatus
  paidAt             DateTime      @map("paid_at") @db.Timestamptz(3)
  /// Provider/cloud reference; unique so a re-delivered payment is recorded once.
  providerReference  String?       @unique @map("provider_reference")
  paymentMethodBrand String        @default("") @map("payment_method_brand")
  paymentMethodLast4 String        @default("") @map("payment_method_last4") @db.VarChar(4)
  referenceType      PaymentType   @map("reference_type")
  /// Ticket id or pension pass id.
  referenceId        String        @map("reference_id")
  /// Parking snapshot at payment time.
  proyectoId         String        @default("") @map("proyecto_id")
  parkingName        String        @default("") @map("parking_name")
  parkingCity        String        @default("") @map("parking_city")
  rawProviderStatus  String        @default("") @map("raw_provider_status")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([usuarioId, paidAt(sort: Desc)])
  @@index([referenceType, referenceId])
  @@index([paidAt])
  @@map("payments")
}

// ───────────────────────── Local: cash register ─────────────────────────

/// Cash payment of a ticket at a POS (bill acceptor).
model CashPaymentSession {
  id                  String                   @id @default(uuid(7)) @db.Uuid
  ticketId            String                   @map("ticket_id") @db.Uuid
  idBoleto            String                   @map("id_boleto")
  status              CashPaymentSessionStatus
  amountExpected      Decimal                  @map("amount_expected") @db.Decimal(12, 2)
  amountReceived      Decimal                  @default(0) @map("amount_received") @db.Decimal(12, 2)
  changeAmount        Decimal                  @default(0) @map("change_amount") @db.Decimal(12, 2)
  moduloId            String                   @map("modulo_id") @db.Uuid
  moduloIdentificador String                   @default("") @map("modulo_identificador")
  moduloNombre        String                   @default("") @map("modulo_nombre")
  deviceId            String                   @default("") @map("device_id")
  cashRegisterShiftId String?                  @map("cash_register_shift_id") @db.Uuid
  startedAt           DateTime                 @map("started_at") @db.Timestamptz(3)
  completedAt         DateTime?                @map("completed_at") @db.Timestamptz(3)
  cancelledAt         DateTime?                @map("cancelled_at") @db.Timestamptz(3)

  ticket            Ticket                    @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  modulo            Modulo                    @relation(fields: [moduloId], references: [id], onDelete: Restrict)
  cashRegisterShift CashRegisterShift?        @relation(fields: [cashRegisterShiftId], references: [id], onDelete: Restrict)
  events            CashPaymentSessionEvent[]
  movement          CashRegisterMovement?

  /// One open session per ticket.
  @@unique([ticketId], map: "cash_payment_sessions_open_ticket_key", where: raw("status = ANY (ARRAY['created'::cash_payment_session_status, 'pending_cash'::cash_payment_session_status, 'partially_paid'::cash_payment_session_status])"))
  @@index([ticketId, status])
  @@index([idBoleto, status])
  @@index([moduloId, startedAt(sort: Desc)])
  @@index([cashRegisterShiftId])
  @@index([startedAt(sort: Desc)])
  @@map("cash_payment_sessions")
}

/// Timeline of a cash session (was CashPaymentSession.events).
model CashPaymentSessionEvent {
  id             String                      @id @default(uuid(7)) @db.Uuid
  sessionId      String                      @map("session_id") @db.Uuid
  type           CashPaymentSessionEventType
  amount         Decimal?                    @db.Decimal(12, 2)
  /// Idempotency key sent by the device; a repeated insertion is ignored.
  idempotencyKey String?                     @map("idempotency_key")
  payload        Json?
  createdAt      DateTime                    @map("created_at") @db.Timestamptz(3)

  session CashPaymentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, idempotencyKey])
  @@index([sessionId, createdAt])
  @@map("cash_payment_session_events")
}

model CashRegisterShift {
  id                    String                  @id @default(uuid(7)) @db.Uuid
  proyectoId            String                  @map("proyecto_id") @db.Uuid
  moduloId              String                  @map("modulo_id") @db.Uuid
  moduloIdentificador   String                  @default("") @map("modulo_identificador")
  moduloNombre          String                  @default("") @map("modulo_nombre")
  openedByUserId        String                  @map("opened_by_user_id") @db.Uuid
  openedByUserName      String                  @default("") @map("opened_by_user_name")
  status                CashRegisterShiftStatus
  openingAmount         Decimal                 @map("opening_amount") @db.Decimal(12, 2)
  openedAt              DateTime                @map("opened_at") @db.Timestamptz(3)
  closedAt              DateTime?               @map("closed_at") @db.Timestamptz(3)
  closingAmountExpected Decimal?                @map("closing_amount_expected") @db.Decimal(12, 2)
  closingAmountCounted  Decimal?                @map("closing_amount_counted") @db.Decimal(12, 2)
  differenceAmount      Decimal?                @map("difference_amount") @db.Decimal(12, 2)
  notes                 String                  @default("")
  metadata              Json?

  modulo              Modulo                 @relation(fields: [moduloId], references: [id], onDelete: Restrict)
  movements           CashRegisterMovement[]
  counts              CashRegisterCount[]
  cut                 CashRegisterCut?
  cashPaymentSessions CashPaymentSession[]

  /// One open shift per cash register (was checked only in code).
  @@unique([moduloId], map: "cash_register_shifts_open_modulo_key", where: raw("status = 'open'::cash_register_shift_status"))
  @@index([moduloId, status])
  @@index([openedByUserId, status])
  @@index([proyectoId, openedAt(sort: Desc)])
  @@map("cash_register_shifts")
}

model CashRegisterMovement {
  id                          String                   @id @default(uuid(7)) @db.Uuid
  shiftId                     String                   @map("shift_id") @db.Uuid
  proyectoId                  String                   @map("proyecto_id") @db.Uuid
  moduloId                    String                   @map("modulo_id") @db.Uuid
  createdByUserId             String                   @map("created_by_user_id")
  createdByUserName           String                   @default("") @map("created_by_user_name")
  type                        CashRegisterMovementType
  direction                   CashMovementDirection
  concept                     String
  amount                      Decimal                  @db.Decimal(12, 2)
  createdAt                   DateTime                 @map("created_at") @db.Timestamptz(3)
  relatedTicketId             String?                  @map("related_ticket_id")
  relatedPaymentId            String?                  @map("related_payment_id")
  /// At most one movement per cash payment session.
  relatedCashPaymentSessionId String?                  @unique @map("related_cash_payment_session_id") @db.Uuid
  idempotencyKey              String?                  @unique @map("idempotency_key")
  notes                       String                   @default("")
  metadata                    Json?

  shift                     CashRegisterShift   @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  relatedCashPaymentSession CashPaymentSession? @relation(fields: [relatedCashPaymentSessionId], references: [id], onDelete: Restrict)

  @@index([shiftId, createdAt(sort: Desc)])
  @@index([proyectoId, createdAt(sort: Desc)])
  @@index([type])
  @@map("cash_register_movements")
}

model CashRegisterCount {
  id                String   @id @default(uuid(7)) @db.Uuid
  shiftId           String   @map("shift_id") @db.Uuid
  countedByUserId   String   @map("counted_by_user_id")
  countedByUserName String   @default("") @map("counted_by_user_name")
  countedAt         DateTime @map("counted_at") @db.Timestamptz(3)
  totalAmount       Decimal  @map("total_amount") @db.Decimal(12, 2)
  notes             String   @default("")

  shift CashRegisterShift       @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  lines CashRegisterCountLine[]

  @@index([shiftId, countedAt(sort: Desc)])
  @@map("cash_register_counts")
}

/// Denomination breakdown of a count (was CashRegisterCount.denominations).
model CashRegisterCountLine {
  countId  String  @map("count_id") @db.Uuid
  /// Keeps the order the cashier entered.
  position Int     @db.SmallInt
  label    String
  value    Decimal @db.Decimal(12, 2)
  quantity Int
  subtotal Decimal @db.Decimal(12, 2)

  count CashRegisterCount @relation(fields: [countId], references: [id], onDelete: Cascade)

  @@id([countId, position])
  @@map("cash_register_count_lines")
}

model CashRegisterCut {
  id                  String                @id @default(uuid(7)) @db.Uuid
  shiftId             String                @unique @map("shift_id") @db.Uuid
  generatedByUserId   String                @map("generated_by_user_id")
  generatedByUserName String                @default("") @map("generated_by_user_name")
  generatedAt         DateTime              @map("generated_at") @db.Timestamptz(3)
  openingAmount       Decimal               @map("opening_amount") @db.Decimal(12, 2)
  totalIn             Decimal               @map("total_in") @db.Decimal(12, 2)
  totalOut            Decimal               @map("total_out") @db.Decimal(12, 2)
  expectedAmount      Decimal               @map("expected_amount") @db.Decimal(12, 2)
  countedAmount       Decimal               @map("counted_amount") @db.Decimal(12, 2)
  differenceAmount    Decimal               @map("difference_amount") @db.Decimal(12, 2)
  status              CashRegisterCutStatus
  notes               String                @default("")

  shift CashRegisterShift @relation(fields: [shiftId], references: [id], onDelete: Restrict)

  @@index([generatedAt(sort: Desc)])
  @@map("cash_register_cuts")
}

// ───────────────────────────── System ─────────────────────────────

/// This server's link to a cloud project. Single row (key = 'default').
model LocalInstallation {
  key                      String                  @id @default("default")
  /// Identifier of this OPERATIVO server, sent to the cloud.
  installationId           String                  @default("") @map("installation_id")
  proyectoId               String                  @default("") @map("proyecto_id")
  proyectoNombre           String                  @default("") @map("proyecto_nombre")
  proyectoIdentificador    String                  @default("") @map("proyecto_identificador")
  source                   LocalInstallationSource @default(manual)
  status                   LocalInstallationStatus @default(pending)
  cloudRequestId           String                  @default("") @map("cloud_request_id")
  /// AES-encrypted sync token issued by the cloud for this installation.
  encryptedSyncToken       String                  @default("") @map("encrypted_sync_token")
  syncTokenIssuedAt        DateTime?               @map("sync_token_issued_at") @db.Timestamptz(3)
  syncTokenRotatedAt       DateTime?               @map("sync_token_rotated_at") @db.Timestamptz(3)
  reviewNote               String                  @default("") @map("review_note")
  requestedAt              DateTime?               @map("requested_at") @db.Timestamptz(3)
  reviewedAt               DateTime?               @map("reviewed_at") @db.Timestamptz(3)
  assignedByUserId         String                  @default("") @map("assigned_by_user_id")
  assignedAt               DateTime?               @map("assigned_at") @db.Timestamptz(3)
  lastConfigurationVersion BigInt?                 @map("last_configuration_version")
  lastAccessVersion        BigInt?                 @map("last_access_version")
  lastSyncAt               DateTime?               @map("last_sync_at") @db.Timestamptz(3)
  lastSyncStatus           ConfigSyncStatus?       @map("last_sync_status")
  lastSyncError            String                  @default("") @map("last_sync_error")
  updatedAt                DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("local_installation")
}

/// Result of each command received from the cloud, so a re-delivered one is not run twice.
model MobileCommandReceipt {
  operationId String   @id @map("operation_id")
  type        String
  result      Json
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@index([processedAt])
  @@map("mobile_command_receipts")
}

model ConfigSyncAudit {
  id                   String            @id @default(uuid(7)) @db.Uuid
  installationId       String            @map("installation_id")
  proyectoId           String            @default("") @map("proyecto_id")
  proyectoNombre       String            @default("") @map("proyecto_nombre")
  triggeredByUserId    String            @default("") @map("triggered_by_user_id")
  triggeredByUserName  String            @default("") @map("triggered_by_user_name")
  triggerSource        ConfigSyncTrigger @default(manual) @map("trigger_source")
  status               ConfigSyncStatus
  startedAt            DateTime          @map("started_at") @db.Timestamptz(3)
  finishedAt           DateTime          @map("finished_at") @db.Timestamptz(3)
  durationMs           Int               @map("duration_ms")
  configurationVersion BigInt?           @map("configuration_version")
  accessVersion        BigInt?           @map("access_version")
  /// Snapshot versions are 40-bit hashes computed by ADMINISTRATIVO (bigint).
  /// counts: { proyecto, modulos, pensiones, pensionPasses, users, permissionProfiles }
  counts               Json              @default("{}")
  errorMessage         String            @default("") @map("error_message")
  errorCode            String            @default("") @map("error_code")
  metadata             Json              @default("{}")

  @@index([startedAt(sort: Desc)])
  @@index([status, startedAt(sort: Desc)])
  @@map("config_sync_audits")
}

model OperationalLog {
  id               String                 @id @default(uuid(7)) @db.Uuid
  kind             OperationalLogKind
  scope            OperationalLogScope
  type             String
  severity         OperationalLogSeverity
  installationId   String                 @default("") @map("installation_id")
  projectId        String                 @default("") @map("project_id")
  projectName      String                 @default("") @map("project_name")
  moduloId         String                 @default("") @map("modulo_id")
  moduloNombre     String                 @default("") @map("modulo_nombre")
  submoduloId      String                 @default("") @map("submodulo_id")
  submoduloNombre  String                 @default("") @map("submodulo_nombre")
  ticketId         String                 @default("") @map("ticket_id")
  paymentSessionId String                 @default("") @map("payment_session_id")
  flowId           String                 @default("") @map("flow_id")
  source           OperationalLogSource
  message          String
  statusBefore     String                 @default("") @map("status_before")
  statusAfter      String                 @default("") @map("status_after")
  metadata         Json                   @default("{}")
  createdAt        DateTime               @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime               @map("updated_at") @db.Timestamptz(3)

  @@index([createdAt(sort: Desc), kind])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([moduloId, createdAt(sort: Desc)])
  @@index([ticketId, createdAt(sort: Desc)])
  @@index([flowId])
  @@index([kind, scope, severity, createdAt(sort: Desc)])
  @@map("operational_logs")
}

/// Aggregated counts kept after the monthly flush deletes the raw logs.
model OperationalLogFlushSummary {
  id             String                  @id @default(uuid(7)) @db.Uuid
  monthKey       String                  @map("month_key")
  dayKey         String                  @map("day_key")
  flushType      OperationalLogFlushType @map("flush_type")
  kind           OperationalLogKind
  scope          OperationalLogScope
  severity       OperationalLogSeverity
  type           String
  installationId String                  @default("") @map("installation_id")
  projectId      String                  @default("") @map("project_id")
  projectName    String                  @default("") @map("project_name")
  moduloId       String                  @default("") @map("modulo_id")
  moduloNombre   String                  @default("") @map("modulo_nombre")
  source         OperationalLogSource
  totalLogs      Int                     @default(0) @map("total_logs")
  firstCreatedAt DateTime                @map("first_created_at") @db.Timestamptz(3)
  lastCreatedAt  DateTime                @map("last_created_at") @db.Timestamptz(3)
  sampleMessage  String                  @default("") @map("sample_message")
  createdAt      DateTime                @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                @map("updated_at") @db.Timestamptz(3)

  @@unique([monthKey, dayKey, flushType, kind, scope, severity, type, installationId, projectId, moduloId, source], map: "operational_log_flush_summary_unique")
  @@index([monthKey, dayKey])
  @@index([createdAt(sort: Desc)])
  @@map("operational_log_flush_summaries")
}

/// Monthly flush settings. Single row (key = 'default').
model MonthlyFlushConfig {
  key                        String    @id @default("default")
  enabled                    Boolean   @default(false)
  partialCurrentMonthEnabled Boolean   @default(false) @map("partial_current_month_enabled")
  closeDay                   Int       @default(1) @map("close_day") @db.SmallInt
  partialDays                Int[]     @default([]) @map("partial_days")
  hour                       Int       @default(2) @db.SmallInt
  minute                     Int       @default(0) @db.SmallInt
  lastAutomaticRunAt         DateTime? @map("last_automatic_run_at") @db.Timestamptz(3)
  updatedAt                  DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  updatedByUserId            String    @default("") @map("updated_by_user_id")
  updatedByUserName          String    @default("") @map("updated_by_user_name")

  @@map("monthly_flush_config")
}

model MonthlyFlushJob {
  id                  String                @id @default(uuid(7)) @db.Uuid
  monthKey            String                @map("month_key")
  triggerType         MonthlyFlushTrigger   @map("trigger_type")
  status              MonthlyFlushJobStatus
  startedAt           DateTime              @map("started_at") @db.Timestamptz(3)
  completedAt         DateTime?             @map("completed_at") @db.Timestamptz(3)
  error               String?
  requestedByUserId   String                @default("") @map("requested_by_user_id")
  requestedByUserName String                @default("") @map("requested_by_user_name")
  summary             Json?

  /// Only one flush may run at a time.
  @@unique([status], map: "monthly_flush_jobs_running_key", where: raw("status = 'running'::monthly_flush_job_status"))
  @@index([startedAt(sort: Desc)])
  @@index([monthKey, triggerType, startedAt(sort: Desc)])
  @@map("monthly_flush_jobs")
}

/// Events recorded in the same transaction as the local change, pushed to the cloud
/// when it is reachable (offline-first). The cloud dedupes by eventId (#8 / ADMIN #12).
///
/// Written by database triggers (function outbox_capture, see the outbox migration) on
/// every insert/update of tickets, payments, cash sessions, shifts, movements, cuts and
/// pension moves: no code path can change those tables without recording the event.
/// The payload is the row as stored (snake_case columns); eventType is
/// "<aggregate>.created" or "<aggregate>.updated".
model OutboxEvent {
  /// Generated by the database (the triggers insert the rows).
  eventId       String    @id @default(dbgenerated("gen_random_uuid()")) @map("event_id") @db.Uuid
  /// Delivery order (insertion order).
  position      BigInt    @unique @default(autoincrement())
  eventType     String    @map("event_type")
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  payload       Json
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lastError     String    @default("") @map("last_error")
  sentAt        DateTime? @map("sent_at") @db.Timestamptz(3)

  /// Delivery queue: pending events in order.
  @@index([position], map: "outbox_events_pending_idx", where: raw("sent_at IS NULL"))
  @@index([aggregateType, aggregateId])
  @@index([sentAt])
  @@map("outbox_events")
}

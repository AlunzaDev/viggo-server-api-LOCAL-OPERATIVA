APP_ENV=dev
PROD=false

# Runtime
HOST=0.0.0.0
PORT=3002
OPERATIVO_FALLBACK_PORT=3005
PUBLIC_PATH=public
WEB_SERVICE_URL=http://localhost:3002
WEB_CLIENT_URL=http://localhost:3004
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:3004,http://127.0.0.1:3004
PROJECT_ID=
# Opcional. En campo recomendado: viggo-0001-local-001.
# Si se deja vacio, OPERATIVO genera y guarda uno estable en su base local.
INSTALLATION_ID=

# Docker local
BACKEND_IMAGE=viggo-server-api-operativo:local
BACKEND_PORT=8081
BACKEND_ENV_FILE=.env.dev

# Postgres local operativo (docker-compose: servicio postgres en 127.0.0.1:5435)
POSTGRES_USER=viggo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=viggo_operativo
DATABASE_URL=postgresql://viggo:change-me@127.0.0.1:5435/viggo_operativo
# Conexiones maximas del pool por instancia de la API.
DATABASE_POOL_MAX=10

# Auth local
ADMINISTRATIVO_API_URL=http://localhost:3000
JWT_SEED=replace-with-a-long-random-secret
INSTALLATION_SECRET_KEY=replace-with-a-32-byte-random-secret
AUTH_COOKIE_NAME=viggo_local_auth
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_MAX_AGE_MS=172800000
# Ventana deliberada de acceso local sin validar contra la nube (1-30 días).
OFFLINE_LOGIN_MAX_AGE_DAYS=7

# Sync desde nube admin
AUTO_CONFIG_SYNC_ENABLED=false
AUTO_CONFIG_SYNC_INTERVAL_MS=86400000
AUTO_CONFIG_SYNC_START_DELAY_MS=10000
MOBILE_COMMANDS_SYNC_ENABLED=false
MOBILE_COMMANDS_SYNC_INTERVAL_MS=15000
MOBILE_COMMANDS_SYNC_START_DELAY_MS=5000
# Envio a la nube de los eventos locales (outbox).
OUTBOX_SYNC_ENABLED=true
OUTBOX_SYNC_INTERVAL_MS=5000
# Dias que se conservan los eventos ya enviados.
OUTBOX_RETENTION_DAYS=30

# Cobro POS local
PAYMENT_CURRENCY=mxn

# Dispositivos locales
BARRIER_SOCKET_REQUIRED=false
BARRIER_SOCKET_TIMEOUT_MS=5000

# Local data retention in days (docs/retencion.md); 0 never purges that kind of data.
RETENTION_LOCAL_OPERATION_DAYS=180
RETENTION_LOCAL_AUDIT_DAYS=90
RETENTION_COMMAND_RECEIPTS_DAYS=30

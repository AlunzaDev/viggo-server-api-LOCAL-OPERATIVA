APP_ENV=dev
PROD=false

# Runtime
HOST=0.0.0.0
PORT=3000
PUBLIC_PATH=public
WEB_SERVICE_URL=http://localhost:3002
WEB_CLIENT_URL=http://localhost:3004
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:3004,http://127.0.0.1:3004
PROJECT_ID=
# Opcional. En campo recomendado: viggo-0001-local-001.
# Si se deja vacio, LOCALOPE genera y guarda uno estable en Mongo local.
INSTALLATION_ID=

# Docker local
BACKEND_IMAGE=viggo-server-api-localope:local
BACKEND_PORT=8081
BACKEND_ENV_FILE=.env.dev

# Mongo local operativo
MONGO_USER=imasd
MONGO_PASS=jidta2026
MONGO_DB_NAME=viggo-localope
MONGO_URL=mongodb://imasd:jidta2026@127.0.0.1:27017/viggo-localope?authSource=admin
MONGO_DISCONNECT_EXIT_DELAY_MS=30000

# Auth local
NUBEADMIN_API_URL=http://localhost:3000
JWT_SEED=replace-with-a-long-random-secret
INSTALLATION_SECRET_KEY=replace-with-a-32-byte-random-secret
AUTH_COOKIE_NAME=viggo_local_auth
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_MAX_AGE_MS=172800000
OFFLINE_LOGIN_MAX_AGE_DAYS=7

# Sync desde nube admin
SYNC_SERVICE_TOKEN=replace-with-an-independent-service-token

# Cobro POS local
PAYMENT_CURRENCY=mxn

# Dispositivos locales
BARRIER_SOCKET_REQUIRED=false
BARRIER_SOCKET_TIMEOUT_MS=5000

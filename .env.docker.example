# Copy to .env.docker for `docker compose --env-file .env.docker up -d --build`.
APP_ENV=prod
PROD=true
HOST=0.0.0.0
PORT=8080
PUBLIC_PATH=public

WEB_SERVICE_URL=http://localhost:8081
WEB_CLIENT_URL=http://localhost:3004
CORS_ALLOWED_ORIGINS=http://localhost:3004

# DATABASE_URL is set by docker-compose from POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB.
# Set a strong POSTGRES_PASSWORD (here or in the shell) before the first start.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_POOL_MAX=10

# Leave empty to generate a stable id on first start (recommended in the field: viggo-0001-local-001).
INSTALLATION_ID=
PROJECT_ID=

ADMINISTRATIVO_API_URL=https://your-admin-api.example.com
JWT_SEED=replace-with-a-long-random-secret-at-least-32-chars
INSTALLATION_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars

AUTH_COOKIE_NAME=viggo_local_auth
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=none
AUTH_COOKIE_MAX_AGE_MS=172800000
OFFLINE_LOGIN_MAX_AGE_DAYS=7

AUTO_CONFIG_SYNC_ENABLED=true
MOBILE_COMMANDS_SYNC_ENABLED=true
OUTBOX_SYNC_ENABLED=true

PAYMENT_CURRENCY=mxn
BARRIER_SOCKET_REQUIRED=true
BARRIER_SOCKET_TIMEOUT_MS=5000

# Postgres backups (hourly pg_dump, kept this many days).
BACKUP_INTERVAL_SECONDS=3600
BACKUP_RETENTION_DAYS=14

# Local data retention in days (docs/retencion.md); 0 never purges that kind of data.
RETENTION_LOCAL_OPERATION_DAYS=180
RETENTION_LOCAL_AUDIT_DAYS=90
RETENTION_COMMAND_RECEIPTS_DAYS=30
